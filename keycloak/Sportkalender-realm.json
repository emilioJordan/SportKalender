{
  "realm": "Sportkalender",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "ROLE_USER",
        "description": "May read events and tasks"
      },
      {
        "name": "ROLE_ADMIN",
        "description": "May read, create, update and delete events and tasks"
      }
    ]
  },
  "clients": [
    {
      "clientId": "sportkalender-frontend",
      "name": "SportKalender Frontend",
      "protocol": "openid-connect",
      "publicClient": true,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "user",
      "enabled": true,
      "email": "user@sportkalender.local",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "user",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ROLE_USER"
      ]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@sportkalender.local",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Admin",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ROLE_ADMIN"
      ]
    }
  ]
}
